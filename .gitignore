# Compiled binaries and shared objects
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries (go test -c) and example binaries (go build in a main package)
*.test
/examples/json-parser/json-parser
/examples/jsmn-demo/jsmn-demo
/examples/production-usage/production-usage
/examples/linenoise-repl/linenoise-repl
/jsmn-go/examples/examples

# Vendored tool binaries — installed by CI / `make install-tools`, never committed
bin/
*/bin/

# Test, coverage, and profiling output
*.out
coverage.txt
coverage.html
*.cover
*.prof
*.pprof

# Go workspace sum (kept local; modules pin their own deps)
go.work.sum

# Generated benchmark fixtures (recreated on demand by `make testdata` or the
# benchmarks themselves) — never committed; see testdata/README.md.
/bench.xml
/testdata/large.json
/testdata/large.xml
/*/testdata/bench.json

# Note: Go writes crash-regression seeds to testdata/fuzz/<FuzzName>/ and those
# SHOULD be committed (they replay on `go test`). The large generated corpus
# lives in $GOCACHE/fuzz, outside the repo, so nothing to ignore here.

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
*.iml
